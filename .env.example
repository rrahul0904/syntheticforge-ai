# Optional AI provider. The application works without these values.
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Production-only values are required when SYNTHETICFORGE_ENV=production.
# Generate the password hash with: python scripts/hash_password.py
# Generate an API token locally, then set only its SHA-256 digest here.
# SYNTHETICFORGE_ENV=production
# SYNTHETICFORGE_APPLICATION_SHA=<40-character image source commit SHA>
# SYNTHETICFORGE_ADMIN_USERNAME=admin
# SYNTHETICFORGE_ADMIN_PASSWORD_HASH=<PBKDF2-SHA256 hash>
# SYNTHETICFORGE_API_TOKEN_SHA256=<64-character SHA-256 hex digest>
# SYNTHETICFORGE_CORS_ORIGINS=https://<exact-public-host>
# SYNTHETICFORGE_HOME=/data
# SYNTHETICFORGE_REPLICAS=1
# WEB_CONCURRENCY=1
# SYNTHETICFORGE_TRUSTED_PROXY_IPS=<trusted-proxy-IP-or-CIDR>
